{
  "mcpServers": {
    "misarpost": {
      "command": "npx",
      "args": [
        "-y",
        "@misarpost/mcp@latest"
      ],
      "env": {
        "MISARPOST_API_KEY": "mpk_YOUR_KEY_HERE"
      }
    },
    "misarpost-remote": {
      "url": "https://api.misar.io/post/mcp",
      "headers": {
        "Authorization": "Bearer mpk_YOUR_KEY_HERE"
      }
    }
  }
}
